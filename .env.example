# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored; this template must only ever hold placeholders.

# --- NationBuilder V2 API (OAuth 2.0) --------------------------------------
# The sole data source. The pipeline pulls all signups from the V2 API using an
# OAuth 2.0 refresh-token flow (see V2_OAUTH_SETUP.md). In AWS these live in the
# Secrets Manager secret.
NATIONBUILDER_SLUG=your-nation-slug
NATIONBUILDER_CLIENT_ID=your-oauth-client-id
NATIONBUILDER_CLIENT_SECRET=your-oauth-client-secret
NATIONBUILDER_REDIRECT_URI=https://localhost:8080/callback
# Obtained from the one-time OAuth authorize handshake; the refresh token is
# durable and is rotated/persisted on each run.
NATIONBUILDER_REFRESH_TOKEN=your-refresh-token
# Optional: a current access token (the client normally mints one from the
# refresh token, so this is usually not needed).
# NATIONBUILDER_ACCESS_TOKEN_V2=
# Parallel page-fetch concurrency for the full pull (default 20).
# NB_LOOKUP_CONCURRENCY=20

# --- ZIP reference workbook ------------------------------------------------
# ZIP -> state validation uses the USPS ZIP_Locale_Detail.xlsx (three sheets).
# Keep it alongside the scripts locally, or source it from S3 at runtime:
# ZIP_LOOKUP_S3_URI=s3://your-bucket/refs/ZIP_Locale_Detail.xlsx
# ZIP_MODE=delivery   # or "physical"

# --- Output location -------------------------------------------------------
# Directory for the generated CSV/XLSX files. Defaults to the current directory
# for local runs. In AWS Lambda set this to /tmp (the only writable path).
# OUTPUT_DIR=.

# --- Optional S3 upload ----------------------------------------------------
# When S3_BUCKET is set, every output file is uploaded to
# s3://<bucket>/<prefix>/<name>. Object names are date-stamped with the run date
# (e.g. zip_state_problems_YYYYMMDD.csv) so a history builds up in the bucket;
# local file names stay undated. A presigned URL is also generated per object.
# Leave S3_BUCKET unset to keep output local only.
# Credentials are NOT set here: locally boto3 uses your AWS profile/env, and in
# Lambda it uses the function's IAM execution role.
# S3_BUCKET=your-bucket-name
# S3_PREFIX=zip-state-reports/
# S3_REGION=us-east-1
# Presigned URL lifetime in seconds (default 604800 = 7 days; that is S3's max).
# PRESIGN_EXPIRY_SECONDS=604800

# --- Optional email notification (Amazon SES) ------------------------------
# When SES_SENDER is set (a verified SES identity) and a recipient list is
# available, the two problem reports are emailed as FILE ATTACHMENTS (dated
# names) after the run. Independent of S3 (attachments come from local files).
# The full dataset is never attached. An attachment is skipped (noted in the
# body) if it would exceed the SES ~10 MB message limit.
# The recipient list is one address per line ("#" comments); source it from S3
# (RECIPIENTS_S3_URI) or a local file (RECIPIENTS_FILE, default recipients.txt).
# SES_SENDER=reports@your-verified-domain
# SES_REGION=eu-west-2
# RECIPIENTS_S3_URI=s3://your-bucket/config/recipients.txt
# RECIPIENTS_FILE=recipients.txt
# Free-text message in the email body (default explains the CSV vs XLSX ZIP issue).
# EMAIL_MESSAGE=...

# --- Optional: AWS Secrets Manager (for Lambda / production) ---------------
# When set, the NATIONBUILDER_* credentials are read from this secret (a JSON
# object whose keys are the NATIONBUILDER_* names above) and used only for vars
# not already set in the environment. Leave unset for local runs.
# NATIONBUILDER_SECRET_ID=nb/v2/prod
# NATIONBUILDER_SECRET_REGION=eu-west-2
